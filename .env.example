# Hugging Face Environment Variables Template
# Copy this to .env and fill in your actual values
# NEVER commit .env with real keys — add to Hugging Face Repository Secrets instead

# Anthropic Claude API Key (get from https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Hugging Face Token (get from https://huggingface.co/settings/tokens)
HF_TOKEN=hf_your-huggingface-token-here

# API Base URL (usually default Hugging Face endpoint)
API_BASE_URL=https://api-inference.huggingface.co

# Model Name (default: google/flan-t5-small)
MODEL_NAME=google/flan-t5-small

# Optional: Override model (default: google/flan-t5-small)
# MODEL_NAME=gpt2

# Optional: Set logging level
# LOG_LEVEL=INFO

# For Hugging Face Spaces deployment:
# 1. Do NOT commit this file with real keys
# 2. Add ANTHROPIC_API_KEY and HF_TOKEN to Space Settings → Repository secrets
# 3. The app will read it from environment automatically
